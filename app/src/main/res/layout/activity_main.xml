<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- نوار بالا -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <ir.scicore.flash.widget.NeumorphIconButton
                android:id="@+id/btnAi"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:src="@drawable/ic_ai"
                android:contentDescription="@string/cd_ai"
                app:nm_radius="15dp" />

            <ir.scicore.flash.widget.NeumorphIconButton
                android:id="@+id/btnBrowser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/cd_browser"
                app:nm_radius="15dp" />

            <ir.scicore.flash.widget.NeumorphIconButton
                android:id="@+id/btnStats"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:src="@drawable/ic_chart"
                android:contentDescription="@string/cd_stats"
                app:nm_radius="15dp" />

            <ir.scicore.flash.widget.NeumorphIconButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/cd_settings"
                app:nm_radius="15dp" />
        </LinearLayout>

        <!-- تبلیغ همسان ادیوری (فقط پس از بارگذاری نمایش داده می‌شود) -->
        <com.adivery.sdk.AdiveryNativeAdView
            android:id="@+id/nativeAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:adivery_native_ad_layout="@layout/view_native_ad_neu" />

        <!-- لیست دک‌ها -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDecks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="110dp"
            android:overScrollMode="never" />

        <!-- حالت خالی -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="32dp">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_style"
                android:alpha="0.55"
                android:contentDescription="@string/empty_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/empty_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_sub"
                android:textSize="14sp"
                android:textColor="@color/textSecondary" />

            <ir.scicore.flash.widget.NeumorphButton
                android:id="@+id/btnEmptyCreate"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/empty_create"
                android:textColor="@color/accentBright"
                android:textSize="15sp"
                app:nm_radius="18dp" />

            <ir.scicore.flash.widget.NeumorphButton
                android:id="@+id/btnEmptyImport"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/empty_import"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                app:nm_radius="18dp" />

            <TextView
                android:id="@+id/tvEmptyAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:drawableStart="@drawable/ic_ai"
                android:drawablePadding="8dp"
                android:padding="6dp"
                android:text="@string/btn_ai_guide"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/accentBright" />
        </LinearLayout>
    </LinearLayout>

    <!-- دکمهٔ شناور -->
    <ir.scicore.flash.widget.NeumorphIconButton
        android:id="@+id/fab"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/cd_fab"
        app:nm_radius="33dp" />
</FrameLayout>
