<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootReview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- نوار بالا -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.neuanki.app.widget.NeumorphIconButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/cd_back"
                app:nm_radius="14dp" />

            <TextView
                android:id="@+id/tvDeckTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:singleLine="true"
                android:ellipsize="marquee" />

            <com.neuanki.app.widget.NeumorphIconButton
                android:id="@+id/btnUndo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_undo"
                android:contentDescription="@string/cd_undo"
                app:nm_radius="14dp" />

            <com.neuanki.app.widget.NeumorphIconButton
                android:id="@+id/btnMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_more"
                android:contentDescription="@string/cd_more"
                app:nm_radius="14dp" />
        </LinearLayout>

        <!-- شمارنده‌ها -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvCountNew"
                style="@style/CountChip"
                android:textColor="@color/countNew"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCountLearn"
                style="@style/CountChip"
                android:textColor="@color/countLearn"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCountDue"
                style="@style/CountChip"
                android:textColor="@color/countDue" />
        </LinearLayout>

        <!-- کارت -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_inset"
            android:padding="6dp">

            <WebView
                android:id="@+id/webCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- ورودی تایپ پاسخ -->
        <EditText
            android:id="@+id/etType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_inset"
            android:padding="12dp"
            android:textSize="15sp"
            android:textColor="@color/textPrimary"
            android:hint="@string/type_answer_hint"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:visibility="gone" />

        <!-- نمایش پاسخ -->
        <com.neuanki.app.widget.NeumorphButton
            android:id="@+id/btnShowAnswer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/show_answer"
            android:textColor="@color/accentBright"
            android:textSize="16sp"
            app:nm_radius="18dp" />

        <!-- دکمه‌های پاسخ -->
        <LinearLayout
            android:id="@+id/answerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.neuanki.app.widget.NeumorphButton
                android:id="@+id/btnAgain"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:textSize="13sp"
                android:textColor="@color/cAgain"
                app:nm_radius="16dp" />

            <com.neuanki.app.widget.NeumorphButton
                android:id="@+id/btnHard"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:textSize="13sp"
                android:textColor="@color/cHard"
                app:nm_radius="16dp" />

            <com.neuanki.app.widget.NeumorphButton
                android:id="@+id/btnGood"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:textSize="13sp"
                android:textColor="@color/cGood"
                app:nm_radius="16dp" />

            <com.neuanki.app.widget.NeumorphButton
                android:id="@+id/btnEasy"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:textSize="13sp"
                android:textColor="@color/cEasy"
                app:nm_radius="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- پوشش پایان جلسه -->
    <LinearLayout
        android:id="@+id/finishedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_check"
            android:contentDescription="@string/finished_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/finished_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/accentBright" />

        <TextView
            android:id="@+id/tvFinishedSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/textSecondary" />

        <com.neuanki.app.widget.NeumorphButton
            android:id="@+id/btnRecheck"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/check_again"
            android:textColor="@color/accentBright"
            android:textSize="15sp"
            app:nm_radius="18dp" />
    </LinearLayout>
</FrameLayout>
